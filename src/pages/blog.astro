---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import BlogCover from '@/components/BlogCover.astro';
import NeuralField from '@/components/NeuralField.astro';
import CTA from '@/components/CTA.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [featured, ...rest] = posts;
const categories = [...new Set(posts.map((p) => p.data.category))].sort();
const fmt = new Intl.DateTimeFormat('es-CO', { dateStyle: 'long', timeZone: 'UTC' });
const initials = (name: string) => name.split(' ').map((w) => w[0]).slice(0, 2).join('');
---

<Base title="Blog" description="Ideas sobre inteligencia artificial, e-commerce, ciberseguridad y transformación digital del equipo de Goline.">
  <section class="relative isolate overflow-hidden pt-40 pb-14">
    <NeuralField class="absolute inset-0 -z-10 size-full opacity-50" density={0.5} />
    <div class="absolute -top-24 left-1/3 -z-10 h-[380px] w-[720px] rounded-full bg-iris/15 blur-[120px]"></div>
    <div class="container-x flex flex-col gap-6">
      <span class="eyebrow">Blog · {posts.length} artículos</span>
      <h1 class="max-w-3xl text-4xl leading-[1.04] font-extrabold tracking-[-0.03em] sm:text-6xl">
        Ideas para construir con <span class="text-gradient">IA y software.</span>
      </h1>
      <p class="max-w-xl text-lg text-mist">Lo que aprendemos construyendo agentes, tiendas e infraestructura para empresas de Latinoamérica.</p>
    </div>
  </section>

  <section class="container-x">
    <!-- Destacado -->
    <article class="card group grid overflow-hidden lg:grid-cols-[1.35fr_1fr]" data-reveal>
      <div class="relative aspect-[16/10] lg:aspect-auto lg:min-h-[380px]">
        <BlogCover slug={featured.id} category={featured.data.category} class="absolute inset-0" />
        <span class="absolute top-5 left-5 rounded-full bg-ink/80 px-3 py-1 font-mono text-[11px] tracking-wider text-paper uppercase backdrop-blur">Más reciente</span>
      </div>
      <div class="flex flex-col justify-center gap-5 p-8 sm:p-10">
        <span class="font-mono text-xs text-iris">{featured.data.category}</span>
        <h2 class="text-3xl leading-tight font-bold">{featured.data.title}</h2>
        <p class="leading-relaxed text-mist">{featured.data.description}</p>
        <div class="flex items-center gap-3 pt-2 text-sm">
          <span class="grid size-9 place-items-center rounded-full bg-brand-gradient font-display text-xs font-bold text-white">{initials(featured.data.author)}</span>
          <span class="flex flex-col leading-tight">
            <span class="font-semibold">{featured.data.author}</span>
            <time class="text-xs text-mist" datetime={featured.data.date.toISOString()}>{fmt.format(featured.data.date)}</time>
          </span>
        </div>
      </div>
    </article>

    <!-- Filtros -->
    <div class="mt-16 flex flex-col gap-5 border-b border-line pb-6 sm:flex-row sm:items-end sm:justify-between">
      <h2 class="text-2xl font-bold">Todos los artículos</h2>
      <div class="blog-filters -mx-5 flex gap-2 overflow-x-auto px-5 pb-1 sm:mx-0 sm:flex-wrap sm:px-0" role="group" aria-label="Filtrar por categoría">
        <button class="filter is-active" data-cat="" aria-pressed="true">Todas</button>
        {categories.map((c) => <button class="filter" data-cat={c} aria-pressed="false">{c}</button>)}
      </div>
    </div>

    <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        [featured, ...rest].map((p, i) => (
          <li data-featured={i === 0 ? '' : undefined} hidden={i === 0} class="post card spotlight group flex flex-col overflow-hidden transition duration-500 hover:-translate-y-1 hover:border-iris/60" data-cat={p.data.category} data-reveal style={`--d:${(i % 3) * 80}ms`}>
            <div class="relative aspect-[16/10] overflow-hidden border-b border-line">
              <BlogCover slug={p.id} category={p.data.category} />
              <span class="absolute bottom-4 left-4 rounded-full border border-line bg-ink/80 px-3 py-1 font-mono text-[11px] text-paper backdrop-blur">{p.data.category}</span>
            </div>
            <div class="flex flex-1 flex-col gap-3 p-6">
              <h3 class="text-xl leading-snug font-semibold">{p.data.title}</h3>
              <p class="line-clamp-3 text-sm leading-relaxed text-mist">{p.data.description}</p>
              <div class="mt-auto flex items-center gap-3 pt-4 text-xs">
                <span class="grid size-8 place-items-center rounded-full border border-line bg-ink-3 font-display text-[11px] font-bold text-paper">{initials(p.data.author)}</span>
                <span class="flex flex-col leading-tight">
                  <span class="font-semibold text-paper">{p.data.author}</span>
                  <time class="text-mist" datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time>
                </span>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="blog-empty mt-10 hidden text-center text-mist">No hay artículos en esta categoría todavía.</p>
  </section>

  <CTA title="¿Quieres que escribamos sobre tu caso?" text="Cuéntanos qué estás construyendo. Si es un buen ejemplo de IA aplicada, lo convertimos en un caso de estudio." />
</Base>

<style>
  .filter {
    flex-shrink: 0;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    color: var(--color-mist);
    white-space: nowrap;
    transition: all 0.3s;
    cursor: pointer;
  }
  .filter:hover { color: var(--color-paper); border-color: var(--color-iris); }
  .filter.is-active { background: var(--color-paper); color: var(--color-ink); border-color: var(--color-paper); }
  .post[hidden] { display: none; }
  /* Cuando sobra una tarjeta en la última fila, la primera y la última ocupan dos columnas. */
  @media (min-width: 1024px) {
    .post.is-wide { grid-column: span 2; flex-direction: row; }
    .post.is-wide > div:first-child { width: 55%; flex-shrink: 0; aspect-ratio: auto; min-height: 300px; border-bottom: 0; border-right: 1px solid var(--color-line); }
    .post.is-wide > div:last-child { justify-content: center; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.blog-filters .filter');
    const posts = document.querySelectorAll<HTMLElement>('.post');
    const empty = document.querySelector<HTMLElement>('.blog-empty');
    const balance = () => {
      const visible = [...posts].filter((p) => !p.hidden);
      posts.forEach((p) => p.classList.remove('is-wide'));
      if (visible.length >= 4 && visible.length % 3 === 1) {
        visible[0].classList.add('is-wide');
        visible.at(-1)!.classList.add('is-wide');
      }
    };
    balance();
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        buttons.forEach((x) => {
          x.classList.toggle('is-active', x === b);
          x.setAttribute('aria-pressed', String(x === b));
        });
        let shown = 0;
        posts.forEach((p) => {
          // El destacado ya se ve arriba; en "Todas" no se repite en la cuadrícula.
          p.hidden = b.dataset.cat ? p.dataset.cat !== b.dataset.cat : p.hasAttribute('data-featured');
          if (!p.hidden) {
            shown++;
            p.classList.add('is-in');
          }
        });
        empty?.classList.toggle('hidden', shown > 0);
        balance();
      }),
    );
  });
</script>
