---
import Base from '@/layouts/Base.astro';
import Logo from '@/components/Logo.astro';
import Icon from '@/components/Icon.astro';
import NeuralField from '@/components/NeuralField.astro';
import Marquee from '@/components/Marquee.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import AgentDemo from '@/components/AgentDemo.astro';
import CTA from '@/components/CTA.astro';
import { services, clients, tech } from '@/data/site';

const [ai, ...rest] = services;

const process = [
  { title: 'Diagnóstico', time: '2 semanas', text: 'Mapeamos procesos y datos, y elegimos el caso con mayor retorno.' },
  { title: 'Prototipo', time: '2–4 semanas', text: 'Un piloto funcionando con tus datos reales y métricas acordadas.' },
  { title: 'Construcción', time: 'Sprints de 2 semanas', text: 'Software en producción, integrado a tus sistemas y seguro.' },
  { title: 'Evolución', time: 'Continuo', text: 'Medimos, ajustamos los modelos y escalamos lo que funciona.' },
];
---

<Base>
  <!-- HERO -->
  <section class="relative isolate overflow-hidden pt-36 pb-24 sm:pt-44 sm:pb-32">
    <div class="grid-bg absolute inset-0 -z-10"></div>
    <NeuralField class="absolute inset-0 -z-10 size-full" />
    <div class="absolute top-0 left-1/2 -z-10 h-[520px] w-[900px] -translate-x-1/2 rounded-full bg-iris/20 blur-[120px]"></div>

    <div class="container-x grid items-center gap-16 lg:grid-cols-[1.25fr_1fr]">
      <div class="flex flex-col gap-8">
        <a href="/ispgo" class="hero-in group inline-flex w-fit items-center gap-3 rounded-full border border-line bg-ink-2/80 py-1.5 pr-4 pl-1.5 text-sm text-mist backdrop-blur transition hover:border-iris" style="--i:0">
          <span class="rounded-full bg-brand-gradient px-2.5 py-0.5 text-xs font-semibold text-white">Nuevo</span>
          ISPGO ahora es un producto de Goline
          <Icon name="arrow" class="size-4 transition group-hover:translate-x-1" />
        </a>
        <h1 class="text-[2.75rem] leading-[1.02] font-extrabold tracking-[-0.035em] sm:text-7xl lg:text-[5.4rem]">
          <span class="hero-in block" style="--i:1">Software e IA</span>
          <span class="hero-in block" style="--i:2">para marcas</span>
          <span class="hero-in block text-gradient" style="--i:3">que avanzan.</span>
        </h1>
        <p class="hero-in max-w-xl text-lg leading-relaxed text-mist sm:text-xl" style="--i:4">
          Construimos producto, automatizamos procesos con agentes de inteligencia artificial y hacemos crecer marcas en Colombia, México y Chile.
        </p>
        <div class="hero-in flex flex-wrap gap-3" style="--i:5">
          <a href="/contacto" class="btn-primary">Agenda un diagnóstico <Icon name="arrow" class="size-4" /></a>
          <a href="#servicios" class="btn-ghost">Ver servicios</a>
        </div>
      </div>

      <div class="relative mx-auto hidden aspect-square w-full max-w-[460px] lg:block" aria-hidden="true">
        <div class="absolute inset-0 animate-[spin_40s_linear_infinite] rounded-full border border-dashed border-line"></div>
        <div class="absolute inset-10 animate-[spin_28s_linear_infinite_reverse] rounded-full border border-line/70"></div>
        <div class="absolute inset-24 rounded-full bg-iris/20 blur-3xl"></div>
        <div class="absolute inset-0 grid animate-float place-items-center">
          <Logo variant="mark" animate class="size-64 drop-shadow-[0_0_60px_rgba(138,92,255,0.45)]" />
        </div>
        <span class="orbit-chip" style="--a:20deg">agentes</span>
        <span class="orbit-chip" style="--a:140deg">datos</span>
        <span class="orbit-chip" style="--a:260deg">marca</span>
      </div>
    </div>
  </section>

  <!-- CLIENTES -->
  <section class="border-y border-line/70 bg-ink-2/40 py-10">
    <div class="container-x flex flex-col gap-6 md:flex-row md:items-center md:gap-12">
      <p class="shrink-0 font-mono text-xs tracking-[0.14em] text-mist uppercase">Marcas que confían en nosotros</p>
      <Marquee items={clients.concat(clients)} class="flex-1" />
    </div>
  </section>

  <!-- SERVICIOS -->
  <section id="servicios" class="container-x scroll-mt-24 pt-32">
    <SectionHeading
      eyebrow="Qué hacemos"
      title="Una firma, cinco capacidades<br/>y la IA en el centro."
      text="Cada proyecto combina ingeniería, datos y diseño de marca. Empezamos por el problema de negocio y terminamos con software en producción."
    />

    <div class="mt-14 grid gap-4 lg:grid-cols-3">
      <a href={`/${ai.slug}`} class="card spotlight group flex flex-col justify-between gap-10 p-8 lg:row-span-2" data-reveal>
        <div class="flex flex-col gap-5">
          <span class="grid size-12 place-items-center rounded-2xl bg-brand-gradient text-white"><Icon name={ai.icon} /></span>
          <span class="font-mono text-xs text-iris">{ai.line}</span>
          <h3 class="text-3xl font-bold">{ai.title}</h3>
          <p class="text-mist">{ai.short}</p>
          <ul class="mt-2 flex flex-col gap-2 text-sm">
            {ai.features.slice(0, 4).map((f) => <li class="flex items-center gap-2"><Icon name="check" class="size-4 text-ember" />{f.title}</li>)}
          </ul>
        </div>
        <span class="inline-flex items-center gap-2 text-sm font-semibold">Conocer Goline AI <Icon name="arrow" class="size-4 transition group-hover:translate-x-1" /></span>
      </a>
      {
        rest.map((s, i) => (
          <a href={`/${s.slug}`} class="card spotlight group flex flex-col gap-4 p-7" data-reveal style={`--d:${(i + 1) * 80}ms`}>
            <div class="flex items-center justify-between">
              <span class="grid size-11 place-items-center rounded-2xl border border-line bg-ink-3 text-paper transition group-hover:border-iris group-hover:text-iris"><Icon name={s.icon} /></span>
              <Icon name="arrow" class="size-5 -rotate-45 text-mist transition group-hover:rotate-0 group-hover:text-paper" />
            </div>
            <span class="font-mono text-xs text-iris">{s.line}</span>
            <h3 class="text-xl font-semibold">{s.title}</h3>
            <p class="text-sm leading-relaxed text-mist">{s.short}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- IA EN ACCIÓN -->
  <section class="container-x pt-32">
    <div class="grid items-center gap-14 lg:grid-cols-2">
      <div class="flex flex-col gap-8">
        <SectionHeading
          eyebrow="IA en producción"
          title="Agentes que <span class='text-gradient'>resuelven</span>, no que conversan."
          text="Nuestros agentes consultan tus sistemas, ejecutan acciones y entregan una respuesta completa. Este es el agente que construimos para ISPGO: diagnostica equipos, abre tickets y envía links de pago por WhatsApp."
        />
        <dl class="grid grid-cols-3 gap-4" data-reveal>
          <div class="flex flex-col gap-1 border-l border-line pl-4">
            <dt class="text-xs text-mist">Disponibilidad</dt>
            <dd class="font-display text-3xl font-bold">24/7</dd>
          </div>
          <div class="flex flex-col gap-1 border-l border-line pl-4">
            <dt class="text-xs text-mist">Canales</dt>
            <dd class="font-display text-3xl font-bold"><span data-count="3">3</span></dd>
          </div>
          <div class="flex flex-col gap-1 border-l border-line pl-4">
            <dt class="text-xs text-mist">Escala a humano</dt>
            <dd class="font-display text-3xl font-bold">Sí</dd>
          </div>
        </dl>
        <a href="/inteligencia-artificial" class="btn-ghost w-fit" data-reveal>Cómo trabajamos la IA <Icon name="arrow" class="size-4" /></a>
      </div>
      <div class="relative" data-reveal>
        <div class="absolute -inset-2 -z-10 rounded-[2.5rem] lg:-inset-6 bg-brand-gradient opacity-20 blur-2xl"></div>
        <AgentDemo />
      </div>
    </div>
  </section>

  <!-- ISPGO -->
  <section class="container-x pt-32">
    <div class="card overflow-hidden" data-reveal>
      <div class="grid gap-10 p-8 sm:p-12 lg:grid-cols-[1fr_1.1fr] lg:items-center">
        <div class="flex flex-col gap-6">
          <span class="eyebrow">Producto propio</span>
          <h2 class="text-3xl font-bold sm:text-5xl">ISPGO</h2>
          <p class="text-xl text-paper">Todo tu ISP en una sola plataforma, de la oficina al poste.</p>
          <p class="text-mist">Facturación, contratos con firma digital, tickets, planta de fibra, monitoreo de OLTs, app para técnicos y un agente de IA en WhatsApp. Lo usan proveedores de internet en Colombia para ordenar su operación.</p>
          <div class="flex flex-wrap gap-3">
            <a href="/ispgo" class="btn-primary">Conocer ISPGO <Icon name="arrow" class="size-4" /></a>
            <a href="https://ispgo.net" class="btn-ghost" rel="noopener">ispgo.net</a>
          </div>
        </div>
        <ul class="grid grid-cols-2 gap-3 text-sm">
          {
            [
              ['chart', 'Facturación y cobros', 'Wompi y OnePay'],
              ['layers', 'Planta de fibra', 'NAP, troncales y muflas'],
              ['wifi', 'OLTGO', 'Monitoreo de OLTs ZTE'],
              ['chat', 'Agente IA', 'WhatsApp con MCP'],
              ['users', 'App de técnicos', 'Actas y GeoNAP'],
              ['bolt', 'MikroTik y SmartOLT', 'Integraciones nativas'],
            ].map(([icon, t, d], i) => (
              <li class="flex flex-col gap-3 rounded-2xl border border-line bg-ink/60 p-4 transition hover:border-iris" data-reveal style={`--d:${i * 60}ms`}>
                <Icon name={icon} class="size-5 text-ember" />
                <span class="font-semibold">{t}</span>
                <span class="text-xs text-mist">{d}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- PROCESO -->
  <section class="container-x pt-32">
    <SectionHeading eyebrow="Cómo trabajamos" title="De la idea a producción en cuatro pasos." center />
    <div class="relative mt-16">
    <div class="absolute top-6 right-[12%] left-[12%] hidden h-px bg-gradient-to-r from-volt via-iris to-ember md:block" aria-hidden="true"></div>
    <ol class="relative grid gap-6 md:grid-cols-4">
      {
        process.map((p, i) => (
          <li class="relative flex flex-col gap-4" data-reveal style={`--d:${i * 120}ms`}>
            <span class="relative z-10 grid size-12 place-items-center rounded-full border border-line bg-ink font-mono text-sm text-paper">
              0{i + 1}
            </span>
            <h3 class="text-xl font-semibold">{p.title}</h3>
            <span class="font-mono text-xs text-iris">{p.time}</span>
            <p class="text-sm leading-relaxed text-mist">{p.text}</p>
          </li>
        ))
      }
    </ol>
    </div>
  </section>

  <!-- TECNOLOGÍA -->
  <section class="pt-32">
    <div class="container-x">
      <SectionHeading eyebrow="Stack" title="Trabajamos con las plataformas que ya usas." center />
    </div>
    <Marquee items={tech} class="mt-12" />
    <Marquee items={[...tech].reverse()} class="mt-8" reverse />
  </section>

  <CTA />
</Base>

<style>
  .hero-in {
    animation: hero-in 1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i) * 110ms + 100ms);
  }
  @keyframes hero-in {
    from { opacity: 0; transform: translateY(24px); filter: blur(8px); }
  }
  .orbit-chip {
    position: absolute;
    top: 50%;
    left: 50%;
    border: 1px solid var(--color-line);
    background: color-mix(in oklab, var(--color-ink-2) 85%, transparent);
    backdrop-filter: blur(8px);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    font: 500 12px var(--font-mono);
    color: var(--color-mist);
    animation: orbit 30s linear infinite;
    --r: 215px;
  }
  @keyframes orbit {
    from { transform: translate(-50%, -50%) rotate(var(--a)) translateX(var(--r)) rotate(calc(-1 * var(--a))); }
    to { transform: translate(-50%, -50%) rotate(calc(var(--a) + 360deg)) translateX(var(--r)) rotate(calc(-1 * var(--a) - 360deg)); }
  }
</style>
