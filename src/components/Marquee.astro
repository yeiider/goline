---
interface Props { items: { name: string; src: string }[]; class?: string; reverse?: boolean }
const { items, class: className = '', reverse = false } = Astro.props;
---

<div class:list={['group relative flex overflow-hidden [mask-image:linear-gradient(90deg,transparent,black_12%,black_88%,transparent)]', className]}>
  {
    [0, 1].map((copy) => (
      <ul
        class:list={['flex shrink-0 animate-marquee items-center gap-16 pr-16 group-hover:[animation-play-state:paused]', { '[animation-direction:reverse]': reverse }]}
        aria-hidden={copy === 1 ? 'true' : undefined}
      >
        {items.map((it) => (
          <li class="shrink-0">
            <img src={it.src} alt={copy === 0 ? it.name : ''} class="h-8 w-auto max-w-40 object-contain opacity-60 transition hover:opacity-100 sm:h-9" loading="lazy" />
          </li>
        ))}
      </ul>
    ))
  }
</div>
