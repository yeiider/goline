---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav } from '@/data/site';

const path = Astro.url.pathname;
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-500 [&.is-scrolled]:border-b [&.is-scrolled]:border-line/70 [&.is-scrolled]:bg-ink/75 [&.is-scrolled]:backdrop-blur-xl"
>
  <div class="container-x flex h-18 items-center justify-between gap-6 py-4">
    <a href="/" class="text-paper" aria-label="Goline, inicio">
      <Logo class="h-8 w-auto sm:h-9" />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Principal">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-full px-4 py-2 text-sm text-mist transition hover:bg-ink-3 hover:text-paper',
              { 'text-paper': path.startsWith(item.href) && item.href !== '/#servicios' },
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a href="/contacto" class="btn-primary hidden sm:inline-flex">
        Hablemos <Icon name="arrow" class="size-4" />
      </a>
      <button
        id="menu-toggle"
        class="grid size-11 place-items-center rounded-full border border-line text-paper lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" class="size-5" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-ink/95 backdrop-blur-xl lg:hidden">
    <nav class="container-x flex flex-col gap-1 py-6" aria-label="Móvil">
      {
        nav.map((item) => (
          <a href={item.href} class="rounded-2xl px-4 py-3 font-display text-2xl text-paper hover:bg-ink-3">
            {item.label}
          </a>
        ))
      }
      <a href="/contacto" class="btn-primary mt-4">Hablemos <Icon name="arrow" class="size-4" /></a>
    </nav>
  </div>
</header>

<script>
  function initHeader() {
    const header = document.getElementById('site-header');
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!header || !toggle || !menu) return;
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 12);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(open));
      header.classList.toggle('is-scrolled', open || window.scrollY > 12);
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.classList.add('hidden')));
  }
  document.addEventListener('astro:page-load', initHeader);
</script>
