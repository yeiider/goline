---
interface Props { eyebrow: string; title: string; text?: string; center?: boolean }
const { eyebrow, title, text, center = false } = Astro.props;
---

<div class:list={['flex max-w-3xl flex-col gap-5', { 'mx-auto items-center text-center': center }]} data-reveal>
  <span class="eyebrow">{eyebrow}</span>
  <h2 class="text-3xl leading-[1.08] font-bold sm:text-5xl" set:html={title} />
  {text && <p class="max-w-2xl text-lg leading-relaxed text-mist">{text}</p>}
</div>
