---
// Portada generativa para artículos del blog: un motivo por categoría, en la paleta de la marca.
// La semilla sale del slug, así cada artículo tiene su propia composición y siempre se dibuja igual.
interface Props {
  slug: string;
  category: string;
  class?: string;
}
const { slug, category, class: className = '' } = Astro.props;

let seed = [...slug].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const W = 640, H = 400;
const uid = `c${seed.toString(36)}`;

type Shape = { kind: 'line' | 'dot' | 'rect' | 'path' | 'ring'; [k: string]: any };
const shapes: Shape[] = [];

const motif = category.toLowerCase();
if (motif.includes('inteligencia')) {
  // Red neuronal en capas, con algunos nodos activos.
  const layers = [4, 6, 6, 3];
  const pts = layers.map((n, li) =>
    Array.from({ length: n }, (_, i) => ({ x: 110 + li * 140, y: H / 2 + (i - (n - 1) / 2) * (H / (n + 1.4)) + (rand() - 0.5) * 14 })),
  );
  pts.slice(0, -1).forEach((layer, li) =>
    layer.forEach((a) => pts[li + 1].forEach((b) => shapes.push({ kind: 'line', x1: a.x, y1: a.y, x2: b.x, y2: b.y, o: 0.12 + rand() * 0.35 }))),
  );
  pts.flat().forEach((p) => shapes.push({ kind: 'dot', x: p.x, y: p.y, r: 7, hot: rand() < 0.22 }));
} else if (motif.includes('commerce')) {
  // Barras que crecen con una curva de conversión encima.
  const n = 9, bw = 38;
  let v = 0.25 + rand() * 0.1;
  const tops: { x: number; y: number }[] = [];
  for (let i = 0; i < n; i++) {
    v = Math.min(0.92, v + 0.04 + rand() * 0.08);
    const x = 70 + i * 58, h = v * (H - 120);
    shapes.push({ kind: 'rect', x, y: H - 50 - h, w: bw, h, o: 0.18 + i * 0.07 });
    tops.push({ x: x + bw / 2, y: H - 70 - h });
  }
  shapes.push({ kind: 'path', d: 'M' + tops.map((t) => `${t.x} ${t.y}`).join(' L'), grad: true });
  tops.forEach((t, i) => i === n - 1 && shapes.push({ kind: 'dot', x: t.x, y: t.y, r: 9, hot: true }));
} else if (motif.includes('ciber')) {
  // Anillos concéntricos con segmentos, como un perímetro de seguridad.
  const cx = W / 2, cy = H / 2;
  for (let i = 0; i < 6; i++) {
    const r = 40 + i * 30, gap = 0.3 + rand() * 0.9, start = rand() * Math.PI * 2;
    shapes.push({ kind: 'ring', cx, cy, r, start, end: start + Math.PI * 2 - gap, o: 0.25 + i * 0.1 });
  }
  shapes.push({ kind: 'dot', x: cx, y: cy, r: 14, hot: true });
} else if (motif.includes('log')) {
  // Rutas ortogonales entre bodegas, de izquierda a derecha, sobre una cuadrícula de puntos.
  for (let i = 0; i < 10; i++) for (let j = 0; j < 6; j++) shapes.push({ kind: 'dot', x: 50 + i * 60, y: 50 + j * 60, r: 2, o: 0.35 });
  const nodes = Array.from({ length: 7 }, (_, i) => ({ x: 50 + i * 90, y: 50 + Math.round(rand() * 5) * 60 }));
  nodes.slice(1).forEach((b, i) => {
    const a = nodes[i];
    shapes.push({ kind: 'path', d: `M${a.x} ${a.y} H${(a.x + b.x) / 2} V${b.y} H${b.x}`, grad: true });
  });
  nodes.forEach((p, i) => shapes.push({ kind: 'dot', x: p.x, y: p.y, r: 9, hot: i === nodes.length - 1 || i === 0 }));
} else {
  // Matriz de puntos tipo mapa de calor.
  const cols = 16, rows = 9;
  const fx = rand() * cols, fy = rand() * rows;
  for (let i = 0; i < cols; i++)
    for (let j = 0; j < rows; j++) {
      const d = Math.hypot(i - fx, (j - fy) * 1.4);
      const heat = Math.max(0, 1 - d / 9) + rand() * 0.15;
      shapes.push({ kind: 'dot', x: 50 + i * 36, y: 55 + j * 36, r: 3 + heat * 9, o: 0.15 + heat * 0.85, hot: heat > 0.85 });
    }
}

const arc = (s: Shape) => {
  const p = (a: number) => `${s.cx + s.r * Math.cos(a)} ${s.cy + s.r * Math.sin(a)}`;
  return `M${p(s.start)} A${s.r} ${s.r} 0 ${s.end - s.start > Math.PI ? 1 : 0} 1 ${p(s.end)}`;
};
const glowX = 120 + rand() * 400, glowY = 80 + rand() * 240;
---

<svg viewBox={`0 0 ${W} ${H}`} class:list={['blog-cover', className]} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <linearGradient id={`${uid}-g`} x1="0" y1="0" x2={W} y2={H} gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#3B5BFF"></stop>
      <stop offset=".5" stop-color="#8A5CFF"></stop>
      <stop offset="1" stop-color="#FF6A3D"></stop>
    </linearGradient>
    <radialGradient id={`${uid}-r`}>
      <stop offset="0" stop-color="#8A5CFF" stop-opacity=".45"></stop>
      <stop offset="1" stop-color="#8A5CFF" stop-opacity="0"></stop>
    </radialGradient>
    <pattern id={`${uid}-p`} width="32" height="32" patternUnits="userSpaceOnUse">
      <path d="M32 0H0V32" fill="none" stroke="#26264A" stroke-width="1" opacity=".5"></path>
    </pattern>
  </defs>
  <rect width={W} height={H} fill="#12122A"></rect>
  <rect width={W} height={H} fill={`url(#${uid}-p)`}></rect>
  <circle cx={glowX} cy={glowY} r="260" fill={`url(#${uid}-r)`}></circle>
  <g class="motif">
    {
      shapes.map((s) => {
        if (s.kind === 'line') return <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} stroke="#8A5CFF" stroke-opacity={s.o} stroke-width="1.4" />;
        if (s.kind === 'rect') return <rect x={s.x} y={s.y} width={s.w} height={s.h} rx="8" fill={`url(#${uid}-g)`} fill-opacity={s.o} />;
        if (s.kind === 'path') return <path d={s.d} fill="none" stroke={s.grad ? `url(#${uid}-g)` : '#A9A8C7'} stroke-opacity={s.grad ? 1 : 0.5} stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />;
        if (s.kind === 'ring') return <path d={arc(s)} fill="none" stroke={`url(#${uid}-g)`} stroke-opacity={s.o} stroke-width="7" stroke-linecap="round" />;
        return (
          <g>
            {s.hot && <circle cx={s.x} cy={s.y} r={s.r * 2.6} fill="#FF6A3D" fill-opacity=".18" class="pulse" />}
            <circle cx={s.x} cy={s.y} r={s.r} fill={s.hot ? '#FF6A3D' : '#A9A8C7'} fill-opacity={s.hot ? 1 : (s.o ?? 0.85)} />
          </g>
        );
      })
    }
  </g>
</svg>

<style>
  .blog-cover {
    display: block;
    width: 100%;
    height: 100%;
  }
  .motif {
    transform-origin: center;
    transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  :global(.group:hover) .motif {
    transform: scale(1.04);
  }
  .pulse {
    transform-box: fill-box;
    transform-origin: center;
    animation: cover-pulse 2.6s ease-in-out infinite;
  }
  @keyframes cover-pulse {
    0%, 100% { transform: scale(0.8); opacity: 0.25; }
    50% { transform: scale(1.15); opacity: 0.7; }
  }
</style>
